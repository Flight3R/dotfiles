#!/bin/zsh

INTERFACE="Wi-Fi"
SOCKS_HOST="127.0.0.1"
SOCKS_PORT="8080"
SSH_HOST="user@server"

cleanup() {
    echo "Wyłączanie proxy..."
    networksetup -setsocksfirewallproxystate "$INTERFACE" off
    exit 0
}

trap cleanup INT TERM

echo "Uruchamianie tunelu SSH SOCKS..."
ssh -N -D "$SOCKS_PORT" "$SSH_HOST" &
SSH_PID=$!

sleep 1

echo "Włączanie proxy SOCKS ${SOCKS_HOST}:${SOCKS_PORT}..."
networksetup -setsocksfirewallproxy "$INTERFACE" "$SOCKS_HOST" "$SOCKS_PORT"
networksetup -setsocksfirewallproxystate "$INTERFACE" on

echo "Proxy aktywne. Ctrl+C aby wyłączyć."

wait $SSH_PID
