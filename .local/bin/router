#!/bin/zsh

SESSION="net"
HOST="192.168.0.1"
SERVER="server"
IFACE="en0"

if tmux has-session -t "$SESSION" 2>/dev/null; then
    exec tmux attach-session -t "$SESSION"
fi

tmux new-session -d -s "$SESSION" "sshuttle -r $SERVER $HOST"
tmux split-window -v "sudo tcpdump -ni $IFACE host $HOST"
tmux select-pane -t 0
exec tmux attach-session -t "$SESSION"
