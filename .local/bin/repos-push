#!/bin/zsh
# 1. Run repos-check command
# 2. Copy its output and open this script
# 3. Select pasted output
# 4. :v/uncommitted/d
# 5. ctrl+b remove rest
xargs -I{} sh -c 'cd {} && git add . && git commit -m "Dockerfile&dockerignore" && git push' <<EOF
compare-server
file-server   
grep-server   
paste-server  
waypoints     
EOF


