#!/bin/zsh
echo "Running after-start procedure..."
printf "Set up macvlan? (Y/n): "
read -r choice
if [[ -z $choice || $choice == [Yy] ]]; then
    echo "Setting up macvlan to connect server with 192.168.0.16/28 network..."
    sudo ip link add macvlan link end0 type macvlan mode bridge; sudo ip addr add 192.168.0.18/28 dev macvlan; sudo ip link set macvlan up
    if [[ $? -eq 0 ]]; then
        echo "Done."
    else
        echo "Failed."
    fi
else
    echo "Skipped."
fi

printf "Mount ssd drives? (Y/n):"
read -r choice
if [[ -z $choice || $choice == [Yy] ]]; then
    echo "Mounting ssd drives..."
    ssd-mount pv
    ssd-mount arrsuite
    if [[ $? -eq 0 ]]; then
        echo "Done."
    else
        echo "Failed."
    fi
else
    echo "Skipped."
fi

printf "Up repositories? (Y/n):"
read -r choice
if [[ -z $choice || $choice == [Yy] ]]; then
    echo "Spinning up deployments..."
    (cd ~/repos; ls -1 | xargs -I {} sh -c 'cd {}; docker compose up --detach')
else
    echo "Skipped."
fi

echo "After-start procedure complete."
