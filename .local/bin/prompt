#!/bin/zsh

# [[ -z $text ]] - if text is empty
printf "Continue? (Y/n): "
read -r choice
if [[ -z $choice || $choice == [Yy] ]]; then
    :
else
    exit 0
fi

printf "Do stuff? (Y/n): "
read -r choice
if [[ -z $choice || $choice == [Yy] ]]; then
    echo "Doing stuff..."
fi

# krocej:
printf "Continue? (Y/n): "
read -r choice
[[ -z $choice || $choice == [Yy] ]] || exit 0

printf "Do stuff? (Y/n): "
read -r choice
[[ -z $choice || $choice == [Yy] ]] && echo "Doing stuff..."
