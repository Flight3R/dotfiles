#!/bin/zsh

set -eu
setopt pipefail

readonly init_file="$HOME/.config/nvim/init.lua"

usage() {
    cat >&2 <<'EOF'
Usage: lsp y|n

  y    Enable LSP in Neovim
  n    Disable LSP in Neovim
EOF
    exit 1
}

# Require exactly one argument.
(( $# == 1 )) || usage

case "$1" in
    y)
        # Uncomment require("lsp_config")
        nvim '+g/^--require("lsp_config")$/s/^--//' \
            '+wq' \
            "$init_file"
        echo "LSP enabled"
        ;;
    n)
        # Comment out require("lsp_config")
        nvim '+g/^require("lsp_config")$/s/^/--/' \
            '+wq' \
            "$init_file"
        echo "LSP disabled"
        ;;
    *)
        usage
        ;;
esac
