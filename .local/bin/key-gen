#!/usr/bin/env python3

import secrets
import string
import sys


def generate_password(length):
    characters = (
        string.ascii_letters +
        string.digits 
        #string.punctuation
    )

    return "".join(
        secrets.choice(characters)
        for _ in range(length)
    )


def main():
    if len(sys.argv) != 2:
        print(f"Usage: {sys.argv[0]} <length>")
        sys.exit(1)

    length = int(sys.argv[1])

    if length < 1:
        raise ValueError("Key lenght must be greater than 0!")

    print(generate_password(length))


if __name__ == "__main__":
    main()
